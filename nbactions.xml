<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.6.3:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>--enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8 -Dgarage.consoleEncoding=native</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <exec.appArgs></exec.appArgs>
            <exec.executable>java</exec.executable>
        </properties>
    </action>
    <action>
        <actionName>run.single.main</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.6.3:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>--enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8 -Dgarage.consoleEncoding=native</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <exec.mainClass>${packageClassName}</exec.mainClass>
            <exec.appArgs></exec.appArgs>
            <exec.executable>java</exec.executable>
        </properties>
    </action>
</actions>
